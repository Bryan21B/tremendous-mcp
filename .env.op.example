# Optional: keep the OAuth client credentials in 1Password instead of plain env vars.
# Copy to .env.op, replace the op:// paths with your item, then launch with:
#   op run --env-file=.env.op -- <command>
# (add --account <your-account>.1password.com if you have several accounts)
TREMENDOUS_CLIENT_ID=op://<vault>/<item>/client_id
TREMENDOUS_CLIENT_SECRET=op://<vault>/<item>/client_secret
